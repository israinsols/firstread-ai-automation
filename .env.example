# Copy this file to .env. Keep real credentials out of Git.
SITE_NAME=Firstread.co.uk
SITE_DOMAIN=firstread.co.uk
SITE_NICHE=Celebrity, News, Tech, Sports, Lifestyle, Law and Food
SITE_LANGUAGE=en-GB
SITE_AUTHOR=Firstread Editorial
CONTACT_EMAIL=hello@firstread.co.uk
POSTS_PER_DAY=1
AUTO_PUBLISH=False
KEYWORD_SEEDS=firstread.co.uk, how to verify celebrity concert dates and tickets in the UK, how to report scam emails and texts in the UK, android phone security and backup, NHS physical activity guidelines for adults in the UK, when do clocks change in the UK, UK consumer rights for faulty goods and refunds, best before vs use by dates in the UK

# Gemini AI Studio free-tier key; leave blank until configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Search Console service-account JSON (store the complete JSON as one env value).
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:firstread.co.uk

# Optional IndexNow key (8-128 letters, digits, or hyphens).
INDEXNOW_KEY=

# Optional platform APIs; keep each platform disabled until setup is complete.
SOCIAL_TELEGRAM=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
SOCIAL_FACEBOOK=False
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v23.0
SOCIAL_PINTEREST=False
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
